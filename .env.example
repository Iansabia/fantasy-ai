# Copy to .env (gitignored). One pair per auth profile named in config/leagues.yaml.
# Profile "ian" -> ESPN_S2_IAN / SWID_IAN, profile "cousin" -> ESPN_S2_COUSIN / SWID_COUSIN.
ESPN_S2_IAN=
SWID_IAN=
ESPN_S2_COUSIN=
SWID_COUSIN=
# Notifications (phone numbers never go in config files)
NOTIFY_TO_IAN=
NOTIFY_TO_COUSIN=
# Only for backend: twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
