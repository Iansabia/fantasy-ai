<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NOT INSTALLED. Saturday 2:00pm ET: recheck (lineups + IR only, fresh news/injuries, only changes what changed).
     Replace __REPO__ with the repo path, copy to ~/Library/LaunchAgents/, then
     launchctl load ~/Library/LaunchAgents/com.fantasyai.saturday.plist
     launchd uses the Mac's local clock (times assume Eastern). If the Mac is asleep at the
     scheduled time, launchd runs the job once on wake. Remove --send to keep it a dry run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fantasyai.saturday</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/fai</string>
    <string>autopilot</string>
    <string>--mode</string>
    <string>recheck</string>
    <string>--jitter</string>
    <string>--notify</string>
    <string>--send</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FAI_NOTIFY_BACKEND</key><string>imessage</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>

  <key>StandardOutPath</key><string>__REPO__/data/launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/launchd.log</string>
</dict>
</plist>
