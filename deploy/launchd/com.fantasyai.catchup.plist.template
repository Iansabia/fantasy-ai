<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NOT INSTALLED. Hourly, and at login: runs a full catch-up only if this week's Thursday run was missed and Sunday kickoff has not passed; otherwise exits immediately.
     Replace __REPO__ with the repo path, copy to ~/Library/LaunchAgents/, then
     launchctl load ~/Library/LaunchAgents/com.fantasyai.catchup.plist
     launchd uses the Mac's local clock (times assume Eastern). If the Mac is asleep at the
     scheduled time, launchd runs the job once on wake. Remove --send to keep it a dry run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fantasyai.catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/fai</string>
    <string>autopilot</string>
    <string>--mode</string>
    <string>catchup</string>
    <string>--jitter</string>
    <string>--notify</string>
    <string>--send</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__REPO__/data/launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/launchd.log</string>
</dict>
</plist>
